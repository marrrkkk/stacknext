{
  "name": "@stacknext/playwright",
  "version": "0.6.1",
  "description": "Playwright fixtures that correlate browser scenarios with StackNext server telemetry",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stacknext/regression": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0 <2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "StackNext contributors",
  "homepage": "https://github.com/marrrkkk/stacknext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marrrkkk/stacknext.git",
    "directory": "packages/playwright"
  },
  "bugs": {
    "url": "https://github.com/marrrkkk/stacknext/issues"
  },
  "keywords": [
    "stacknext",
    "nextjs",
    "playwright",
    "testing",
    "tracing",
    "regression-testing"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
