{
  "name": "@nextscope/mcp",
  "version": "0.1.0",
  "description": "Read-only Model Context Protocol server for NextScope telemetry",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nextscope/core": "workspace:*",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
