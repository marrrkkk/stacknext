{
  "name": "@stacknext/core",
  "version": "0.6.1",
  "description": "Core telemetry schema, redaction, configuration and bounded storage for StackNext",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js",
      "default": "./dist/transport.js"
    },
    "./config-file": {
      "types": "./dist/config-file.d.ts",
      "import": "./dist/config-file.js",
      "default": "./dist/config-file.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots.d.ts",
      "import": "./dist/snapshots.js",
      "default": "./dist/snapshots.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "StackNext contributors",
  "homepage": "https://github.com/marrrkkk/stacknext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marrrkkk/stacknext.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/marrrkkk/stacknext/issues"
  },
  "keywords": [
    "stacknext",
    "nextjs",
    "opentelemetry",
    "observability",
    "debugging",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  }
}
