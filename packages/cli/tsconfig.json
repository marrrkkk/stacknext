{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@stacknext/core": [
        "../core/src/index.ts"
      ],
      "@stacknext/core/config-file": [
        "../core/src/config-file.ts"
      ],
