{
  "name": "@stacknext/cli",
  "version": "0.6.0",
  "description": "Local-first runtime debugging, diagnostics and Playwright regression testing for Next.js",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stacknext": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stacknext/core": "workspace:*",
    "@stacknext/dashboard": "workspace:*",
    "@stacknext/diagnostics": "workspace:*",
    "@stacknext/mcp": "workspace:*",
    "@stacknext/regression": "workspace:*",
    "commander": "14.0.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "StackNext contributors",
  "homepage": "https://github.com/marrrkkk/stacknext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marrrkkk/stacknext.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/marrrkkk/stacknext/issues"
  },
  "keywords": [
    "stacknext",
    "nextjs",
    "cli",
    "opentelemetry",
    "debugging",
    "regression-testing",
    "local-first"
  ],
  "publishConfig": {
    "access": "public"
  }
}
