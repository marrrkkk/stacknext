{
  "name": "stacknext-monorepo",
  "version": "0.14.0",
  "private": true,
  "description": "Local-first runtime debugging, diagnostics and Playwright regression testing for Next.js",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:dashboard": "node scripts/benchmark-dashboard.mjs",
    "benchmark:diagnostics": "node scripts/benchmark-diagnostics.mjs",
    "benchmark:verbose": "node scripts/benchmark-verbose.mjs",
    "example:dev": "pnpm --filter @stacknext/example dev",
    "test:packages": "node scripts/validate-packages.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "release:plan": "node scripts/plan-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "changelog:sync": "node scripts/sync-changelog.mjs",
    "changelog:check": "node scripts/sync-changelog.mjs --check",
    "check:docs": "node scripts/sync-docs.mjs --check && node scripts/check-docs.mjs && node scripts/sync-changelog.mjs --check",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check && node scripts/check-docs.mjs && node scripts/sync-changelog.mjs --check",
    "docs:dev": "cd apps/docs && npx --yes mint@4.2.1165 dev"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  },
  "author": "StackNext contributors",
  "homepage": "https://github.com/marrrkkk/stacknext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marrrkkk/stacknext.git"
  },
  "bugs": {
    "url": "https://github.com/marrrkkk/stacknext/issues"
  },
  "keywords": [
    "nextjs",
    "debugging",
    "observability",
    "opentelemetry",
    "playwright",
    "regression-testing",
    "mcp"
  ]
}
